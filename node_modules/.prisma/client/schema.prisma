generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  SOCIAL
  GAMING
  WORK
  WEB
  OTHER
}

enum ActivityAction {
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_DELETED
  CREDENTIAL_CREATED
  CREDENTIAL_UPDATED
  CREDENTIAL_DELETED
}

model Service {
  id          String       @id @default(cuid())
  name        String
  category    Category     @default(OTHER)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  credentials Credential[]
  activities  Activity[]

  @@index([name])
  @@index([category])
  @@index([updatedAt])
}

model Credential {
  id        String   @id @default(cuid())
  serviceId String
  email     String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([email])
}

model Activity {
  id        String         @id @default(cuid())
  action    ActivityAction
  serviceId String?
  createdAt DateTime       @default(now())
  service   Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
